Project eel_shop {
  database_type: 'MySQL'
  Note: 'Database website ban luon: luon song, so che, che bien san, combo. Quan ly kho theo lo, RBAC, gio hang guest/customer.'
}


// =====================================================
// ENUMS
// =====================================================
Enum user_status_enum {
  pending
  active
  inactive
  banned
}

Enum gender_enum {
  male
  female
  other
}

Enum loyalty_tier_enum {
  standard
  silver
  gold
  vip
}

Enum loyalty_tx_enum {
  earn
  redeem
  adjust
  expire
  refund
}

Enum product_status_enum {
  draft
  active
  hidden
  discontinued
}

Enum variant_kind_enum {
  live
  fresh_processed
  canned
  vacuum_pack
  combo
  condiment
}

Enum unit_enum {
  kg
  pack
  can
  combo
  piece
}

Enum supplier_kind_enum {
  farm
  processor
  condiment_vendor
}

Enum storage_enum {
  live_tank
  chilled
  frozen
  ambient
}

Enum batch_status_enum {
  available
  quarantine
  expired
  depleted
  discarded
}

Enum inventory_tx_enum {
  receive
  sale
  cancel_restore
  wastage
  adjust
  expire_discard
}

Enum cart_status_enum {
  active
  merged
  abandoned
}

Enum order_status_enum {
  pending
  processing
  shipping
  completed
  cancelled
}

Enum processing_step_enum {
  preparing_eel
  packing
}

Enum payment_method_enum {
  cod
  bank_transfer
  momo
  vnpay
}

Enum payment_status_enum {
  unpaid
  paid
  refunded
}

Enum discount_kind_enum {
  percent
  fixed
}

Enum review_status_enum {
  pending
  approved
  hidden
}

Enum article_status_enum {
  draft
  published
  archived
}

// =====================================================
// 1. AUTH & RBAC
// =====================================================
Table roles {
  id int [pk, increment]
  code varchar(30) [not null, unique, note: 'guest | customer | staff | admin']
  name varchar(100) [not null]
  description varchar(255)
  is_system boolean [not null, default: true]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  Note: 'Guest la role logic: khong co ban ghi trong users'
}

Table permissions {
  id int [pk, increment]
  code varchar(80) [not null, unique, note: 'dang module.action, vd: order.update_status']
  name varchar(150) [not null]
  module varchar(40) [not null]
  description varchar(255)
}

Table role_permissions {
  role_id int [not null, ref: > roles.id]
  permission_id int [not null, ref: > permissions.id]
  indexes {
    (role_id, permission_id) [pk]
  }
}

Table users {
  id bigint [pk, increment]
  email varchar(191) [not null, unique]
  phone varchar(20) [unique]
  password_hash varchar(255) [not null]
  full_name varchar(150) [not null]
  avatar_url varchar(500)
  status user_status_enum [not null, default: 'pending']
  email_verified_at datetime
  last_login_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  deleted_at datetime [note: 'soft delete']
  indexes {
    status
  }
}

Table user_roles {
  user_id bigint [not null, ref: > users.id]
  role_id int [not null, ref: > roles.id]
  assigned_by bigint [ref: > users.id]
  assigned_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (user_id, role_id) [pk]
    role_id
  }
}

Table customer_profiles {
  user_id bigint [pk, ref: - users.id]
  gender gender_enum
  birth_date date
  loyalty_points int [not null, default: 0, note: 'so du diem hien tai']
  loyalty_tier loyalty_tier_enum [not null, default: 'standard']
  total_spent decimal(14,0) [not null, default: 0]
  marketing_opt_in boolean [not null, default: false]
}

Table staff_profiles {
  user_id bigint [pk, ref: - users.id]
  employee_code varchar(20) [not null, unique]
  position varchar(100)
  hired_at date
  is_active boolean [not null, default: true]
}

Table user_addresses {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  label varchar(50) [default: 'Nha rieng']
  recipient_name varchar(150) [not null]
  recipient_phone varchar(20) [not null]
  province varchar(100) [not null]
  district varchar(100) [note: 'NULL neu khong con cap huyen']
  ward varchar(100) [not null]
  address_line varchar(255) [not null]
  is_default boolean [not null, default: false]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (user_id, is_default)
  }
}

Table loyalty_transactions {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  order_id bigint [ref: > orders.id]
  type loyalty_tx_enum [not null]
  points int [not null, note: 'co dau: + cong, - tru']
  balance_after int [not null]
  note varchar(255)
  created_by bigint [ref: > users.id]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (user_id, created_at)
  }
}

// =====================================================
// 2. CATALOG
// =====================================================
Table categories {
  id int [pk, increment]
  parent_id int [ref: > categories.id]
  name varchar(150) [not null]
  slug varchar(180) [not null, unique]
  description varchar(500)
  image_url varchar(500)
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (parent_id, sort_order)
  }
}

Table products {
  id bigint [pk, increment]
  category_id int [not null, ref: > categories.id]
  name varchar(200) [not null]
  slug varchar(220) [not null, unique]
  short_description varchar(500)
  description text
  thumbnail_url varchar(500)
  origin varchar(150) [note: 'vung nuoi / xuat xu']
  search_keywords varchar(500) [note: 'tu khoa khong dau de tim kiem']
  status product_status_enum [not null, default: 'draft']
  is_featured boolean [not null, default: false]
  avg_rating decimal(3,2) [not null, default: 0]
  review_count int [not null, default: 0]
  created_by bigint [ref: > users.id]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (category_id, status)
    (is_featured, status)
  }
  Note: 'FULLTEXT ft_products_search (name, search_keywords, short_description) duoc khai bao trong schema.sql'
}

Table product_images {
  id bigint [pk, increment]
  product_id bigint [not null, ref: > products.id]
  url varchar(500) [not null]
  alt_text varchar(200)
  sort_order int [not null, default: 0]
  is_primary boolean [not null, default: false]
  indexes {
    (product_id, sort_order)
  }
}

Table product_variants {
  id bigint [pk, increment]
  product_id bigint [not null, ref: > products.id]
  sku varchar(50) [not null, unique]
  name varchar(150) [not null]
  variant_type variant_kind_enum [not null]
  unit unit_enum [not null]
  weight_grams int [not null, default: 0, note: 'khoi luong tinh cho 1 don vi (kg = 1000)']
  price decimal(12,0) [not null, note: 'gia / 1 don vi (VND)']
  sale_price decimal(12,0)
  min_order_qty decimal(10,3) [not null, default: 1]
  qty_step decimal(10,3) [not null, default: 1, note: 'luon song: 0.5 kg']
  max_order_qty decimal(10,3)
  shelf_life_days smallint [note: 'han dung mac dinh de goi y expiry_date khi nhap lo']
  requires_cold_chain boolean [not null, default: false]
  storage_instructions varchar(300)
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (product_id, is_active)
    (variant_type, is_active)
    price
  }
}

Table combo_items {
  combo_variant_id bigint [not null, ref: > product_variants.id]
  component_variant_id bigint [not null, ref: > product_variants.id]
  quantity decimal(10,3) [not null]
  indexes {
    (combo_variant_id, component_variant_id) [pk]
    component_variant_id
  }
  Note: 'Ton kho combo duoc tru o cac bien the thanh phan'
}

Table price_histories {
  id bigint [pk, increment]
  variant_id bigint [not null, ref: > product_variants.id]
  old_price decimal(12,0) [not null]
  new_price decimal(12,0) [not null]
  old_sale_price decimal(12,0)
  new_sale_price decimal(12,0)
  changed_by bigint [not null, ref: > users.id]
  reason varchar(255)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (variant_id, created_at)
  }
}

// =====================================================
// 3. INVENTORY (THEO LO)
// =====================================================
Table suppliers {
  id int [pk, increment]
  name varchar(200) [not null]
  supplier_type supplier_kind_enum [not null]
  contact_name varchar(150)
  phone varchar(20)
  email varchar(191)
  address varchar(300)
  is_active boolean [not null, default: true]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table inventory_batches {
  id bigint [pk, increment]
  batch_code varchar(50) [not null, unique]
  variant_id bigint [not null, ref: > product_variants.id]
  supplier_id int [ref: > suppliers.id]
  received_by bigint [ref: > users.id]
  storage_condition storage_enum [not null]
  produced_date date [note: 'ngay san xuat / so che']
  received_date date [not null, note: 'ngay nhap']
  expiry_date date [not null, note: 'ngay het han']
  quantity_received decimal(12,3) [not null]
  quantity_remaining decimal(12,3) [not null]
  unit_cost decimal(12,0) [not null, default: 0]
  status batch_status_enum [not null, default: 'available']
  note varchar(300)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (variant_id, status, expiry_date) [name: 'idx_batch_fefo']
    (expiry_date, status)
    supplier_id
  }
}

Table inventory_transactions {
  id bigint [pk, increment]
  batch_id bigint [not null, ref: > inventory_batches.id]
  type inventory_tx_enum [not null]
  quantity_change decimal(12,3) [not null, note: 'co dau: + nhap, - xuat']
  order_id bigint [ref: > orders.id]
  performed_by bigint [ref: > users.id, note: 'NULL = he thong']
  note varchar(300)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (batch_id, created_at)
    order_id
    (type, created_at)
  }
}

// =====================================================
// 4. CART (GUEST + CUSTOMER)
// =====================================================
Table carts {
  id bigint [pk, increment]
  user_id bigint [unique, ref: > users.id, note: 'NULL neu la gio cua guest']
  guest_token varchar(64) [unique, note: 'cookie HttpOnly cua khach vang lai']
  status cart_status_enum [not null, default: 'active']
  merged_into_cart_id bigint [ref: > carts.id]
  merged_at datetime
  expires_at datetime [note: 'don gio guest het han']
  last_activity_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (status, expires_at)
    merged_into_cart_id
  }
  Note: 'CHECK (user_id IS NOT NULL OR guest_token IS NOT NULL) - xem schema.sql'
}

Table cart_items {
  id bigint [pk, increment]
  cart_id bigint [not null, ref: > carts.id]
  variant_id bigint [not null, ref: > product_variants.id]
  quantity decimal(10,3) [not null]
  added_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (cart_id, variant_id) [unique]
    variant_id
  }
}

// =====================================================
// 5. ORDERS
// =====================================================
Table coupons {
  id int [pk, increment]
  code varchar(40) [not null, unique]
  description varchar(255)
  discount_type discount_kind_enum [not null]
  discount_value decimal(12,2) [not null]
  min_order_amount decimal(12,0) [not null, default: 0]
  max_discount_amount decimal(12,0)
  usage_limit int
  used_count int [not null, default: 0]
  starts_at datetime
  ends_at datetime
  is_active boolean [not null, default: true]
  created_by bigint [ref: > users.id]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table orders {
  id bigint [pk, increment]
  order_code varchar(30) [not null, unique]
  user_id bigint [not null, ref: > users.id]
  status order_status_enum [not null, default: 'pending']
  processing_step processing_step_enum [note: 'chi co gia tri khi status = processing']
  assigned_staff_id bigint [ref: > users.id, note: 'nhan vien dang phu trach']
  recipient_name varchar(150) [not null]
  recipient_phone varchar(20) [not null]
  shipping_province varchar(100) [not null]
  shipping_district varchar(100)
  shipping_ward varchar(100) [not null]
  shipping_address_line varchar(255) [not null]
  customer_note varchar(500)
  subtotal decimal(12,0) [not null]
  discount_amount decimal(12,0) [not null, default: 0]
  points_used int [not null, default: 0]
  points_discount decimal(12,0) [not null, default: 0]
  shipping_fee decimal(12,0) [not null, default: 0]
  total_amount decimal(12,0) [not null]
  points_earned int [not null, default: 0]
  coupon_id int [ref: > coupons.id]
  payment_method payment_method_enum [not null, default: 'cod']
  payment_status payment_status_enum [not null, default: 'unpaid']
  paid_at datetime
  shipper_name varchar(150)
  shipper_phone varchar(20)
  tracking_code varchar(60)
  cancel_reason varchar(300)
  cancelled_by bigint [ref: > users.id]
  placed_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  confirmed_at datetime
  shipped_at datetime
  completed_at datetime
  cancelled_at datetime
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (user_id, placed_at)
    (status, placed_at)
    (assigned_staff_id, status)
    payment_status
    completed_at
  }
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.id]
  variant_id bigint [not null, ref: > product_variants.id]
  product_name varchar(200) [not null, note: 'snapshot']
  variant_name varchar(150) [not null, note: 'snapshot']
  sku varchar(50) [not null, note: 'snapshot']
  unit varchar(10) [not null]
  quantity decimal(10,3) [not null]
  unit_price decimal(12,0) [not null]
  line_total decimal(12,0) [not null]
  indexes {
    order_id
    variant_id
  }
}

Table order_item_batches {
  id bigint [pk, increment]
  order_item_id bigint [not null, ref: > order_items.id]
  batch_id bigint [not null, ref: > inventory_batches.id]
  quantity decimal(12,3) [not null]
  indexes {
    (order_item_id, batch_id) [unique]
    batch_id
  }
  Note: 'Truy xuat nguon goc: don nao da dung lo nao'
}

Table order_status_histories {
  id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.id]
  from_status order_status_enum
  to_status order_status_enum [not null]
  processing_step processing_step_enum
  changed_by bigint [ref: > users.id, note: 'nhan vien / khach / NULL = he thong']
  note varchar(500)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (order_id, created_at)
    (changed_by, created_at)
  }
}

// =====================================================
// 6. REVIEWS & CONTENT
// =====================================================
Table reviews {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  product_id bigint [not null, ref: > products.id]
  order_item_id bigint [not null, unique, ref: - order_items.id, note: 'moi dong hang chi duoc danh gia 1 lan']
  rating tinyint [not null, note: '1..5']
  title varchar(150)
  comment text
  status review_status_enum [not null, default: 'pending']
  moderated_by bigint [ref: > users.id]
  moderated_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (product_id, status, created_at)
    user_id
  }
}

Table articles {
  id bigint [pk, increment]
  author_id bigint [not null, ref: > users.id]
  title varchar(250) [not null]
  slug varchar(270) [not null, unique]
  summary varchar(500)
  content text [not null]
  thumbnail_url varchar(500)
  status article_status_enum [not null, default: 'draft']
  published_at datetime
  view_count int [not null, default: 0]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (status, published_at)
  }
}

// =====================================================
// TABLE GROUPS (de ERD de nhin)
// =====================================================
TableGroup auth_rbac {
  roles
  permissions
  role_permissions
  users
  user_roles
  customer_profiles
  staff_profiles
  user_addresses
  loyalty_transactions
}

TableGroup catalog {
  categories
  products
  product_images
  product_variants
  combo_items
  price_histories
}

TableGroup inventory {
  suppliers
  inventory_batches
  inventory_transactions
}

TableGroup cart {
  carts
  cart_items
}

TableGroup ordering {
  coupons
  orders
  order_items
  order_item_batches
  order_status_histories
}

TableGroup content_review {
  reviews
  articles
}